export const snapshot = {};

snapshot[`emits canonical GitHub Actions YAML 1`] = `
name: CI
on:
  pull_request: {}
  push: {}
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          fetch-depth: 1
          persist-credentials: false

      - name: Build
        run: |-
          deno task build

  test:
    runs-on:
      - SELF-HOSTED
      - linux
      - x64
    needs:
      - build
    steps:
      - name: Test
        id: test-step
        if: github.ref == 'refs/heads/main'
        continue-on-error: true
        run: |-
          deno test

      - run: |-
          echo first
          echo second

  deploy:
    runs-on:
      group: production-runners
      labels:
        - self-hosted
        - linux
        - x64
    needs:
      - build
      - test
    steps:
      - name: Deploy
        run: |-
          ./deploy

`;
