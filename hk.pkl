amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

steps {
  ["generate-check"] {
    check = "cd .github && deno task tsugiori generate --check"
  }
  ["deno-fmt"] = Builtins.deno
  ["deno-lint"] {
    glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
    check = "deno lint {{files}}"
  }
  ["deno-check"] = (Builtins.deno_check) {
    exclude = List("examples/**")
    check = "deno check --allow-import=deno.land:443,jsr.io:443,esm.sh:443,raw.esm.sh:443,cdn.jsdelivr.net:443,raw.githubusercontent.com:443,gist.githubusercontent.com:443,tsugiori.atty303.workers.dev:443 {{files}}"
  }
  ["hk-test"] = Builtins.hk_test
}
