{
  "name": "tsugiori",
  "workers_dev": true,
  "main": "../../dist/type-service/worker.js",
  "compatibility_date": "2026-10-05",
  "no_bundle": true,
  "build": { "command": "mise run type-service:build", "cwd": "../..", "watch_dir": "src" },
  "cache": { "enabled": true },
  "observability": {
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
